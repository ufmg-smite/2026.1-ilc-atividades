# ============================================================
#  ALL course and student data lives under dados/ — one folder,
#  one rule. Nothing inside it is ever committed:
#    dados/exports/    respostas exportadas do Supabase (texto + fotos)
#    dados/correcoes/  gabaritos gerados (.tex/.pdf/.html)
#    dados/pipeline/   work.db, scans preparados, logs da transcrição
# ============================================================
dados/

# Belt-and-braces: an export written anywhere else is still ignored, so a
# mistyped -o can never put student work into a commit.
*_export/

# Never commit exported answers or any local secrets
*.csv
*_for_analysis.txt


.env
.env.*
SETUP.md

# Quiz QUESTIONS live in the database (authored via admin.html), not the repo —
# keep the seed out of the public repo so students can't read questions early.
supabase/quizzes.sql

# Local tooling / cache — not part of the site
.claude/
__pycache__/
*.pyc
# Barema seeds carry the QUESTIONS and the GABARITO (reference answers) —
# same reason quizzes.sql is ignored: students must not read them in advance.
supabase/correction_seed_*.sql
